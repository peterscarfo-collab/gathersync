# InstantDB Configuration
INSTANT_APP_ID=your_instant_app_id_here
INSTANT_APP_ADMIN_TOKEN=your_instant_admin_token_here
EXPO_PUBLIC_INSTANT_APP_ID=your_instant_app_id_here
NEXT_PUBLIC_INSTANT_APP_ID=your_instant_app_id_here

# OAuth Configuration (Legacy - can be replaced with InstantDB auth)
APP_ID=your_app_id_here
SESSION_SECRET=your_session_secret_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Server Configuration
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:8081
EXPO_PUBLIC_OAUTH_REDIRECT_URL=http://localhost:8081
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# Optional auth/cookie hardening for production:
# - Leave COOKIE_DOMAIN empty unless you explicitly need a shared parent domain.
# - Add extra frontend origins as a comma-separated list for CORS.
COOKIE_DOMAIN=
EXTRA_CORS_ORIGINS=
# Keep debug endpoints disabled in production unless actively troubleshooting.
ENABLE_DEBUG_ROUTES=false

# Backup status threshold (used by scripts/backup-status.ts)
BACKUP_MAX_AGE_HOURS=24

# Optional Dropbox backup target folder (default: ~/Dropbox/GatherSync-Backups)
DROPBOX_BACKUP_DIR=

# Stripe Configuration (for subscriptions)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Deployment
FLY_APP_NAME=gathersync
