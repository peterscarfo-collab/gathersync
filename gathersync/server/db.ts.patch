+export async function getInvitedEvents(email: string, userId: number) {
+  const db = await getDb();
+  if (!db) return [];
+
+  // Find events where the user is a participant (by email) but NOT the owner
+  const invitedEvents = await db.select({ event: events })
+    .from(events)
+    .innerJoin(participants, eq(events.id, participants.eventId))
+    .where(and(eq(participants.email, email), ne(events.userId, userId)));
+    
+  return invitedEvents.map(row => row.event);
+}
